# Serves the prerendered output of `npm run build` (adapter-static, plain
# HTML/CSS/JS, no server process behind it). There is nothing for Caddy to
# reverse-proxy or execute — this is a static file server, full stop, which
# is the whole point of the project's "no required backend for the reader or
# widget" promise: the submission form's webhook is a separate service this
# container never talks to.
#
# Port 8080, not 80: binding a port below 1024 needs root or a Linux
# capability, and this runs as a non-root user (see Dockerfile). No TLS is
# terminated here either; that is expected to sit in front of this
# container, not inside it.
:8080 {
	root * /srv
	encode zstd gzip

	# Baseline browser hardening for every static response. A strict CSP needs
	# a separate nonce/hash migration because the prerendered app and generated
	# page previews intentionally contain inline bootstrap code.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
	}

	# The three things a member's own site fetches from this one. Without these
	# the widget cannot work anywhere except this domain, which is the opposite
	# of what it is for.
	#
	# `embed.v1.js` is a `type="module"` script, and module scripts are always
	# fetched in CORS mode — unlike a classic script, which is `no-cors` and
	# would have loaded cross-origin without any of this. So a member pasting
	# the documented snippet got a script that silently never executed and a
	# `<indienode-widget>` that stayed an unknown element: no error on their
	# page, nothing in this server's log, just a blank space.
	#
	# `ring.json` is the fetch the widget makes once it does run, and it is
	# cross-origin for exactly the same reason. Either one missing is enough to
	# leave the widget dead on every site but this one.
	#
	# `*` rather than an allowlist: the ring is public data served to anybody,
	# the whole design is that a member's site is not registered with this one,
	# and no request here carries a credential for `*` to be unsafe with. The
	# badge and text tiers are an `<img>` and an `<a>`, which need no CORS at
	# all — which is why those two kept working while the full widget did not,
	# and why that difference is the symptom to recognize this by.
	@embeddable path /embed.js /embed.v1.js /ring.json
	header @embeddable Access-Control-Allow-Origin "*"

	# Every real route is prerendered to its own flat file (join.html,
	# members.html, ...), NOT a directory with an index.html inside it, and
	# there is no trailingSlash config to change that (see vite.config.js).
	# Appending .html is therefore correct, and `{path}/` must NOT be in this
	# list: that would make a path like `/join/` resolve to a directory
	# listing attempt instead of falling through to the real file, in a way
	# that would only ever look right by accident on routes that happen to
	# have no trailing content of their own.
	try_files {path} {path}.html
	file_server

	# adapter-static's `fallback: '404.html'` (see vite.config.js, and
	# src/routes/+error.svelte for what it renders) is what an unmatched
	# path gets. Without naming it here, an unmatched request still 404s
	# correctly, just with Caddy's own bare "404 Not Found" instead of the
	# app's real error page.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
