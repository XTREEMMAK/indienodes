#!/bin/sh
# Refuses a push whose committed ring mirror is malformed.
#
# `ci.yml` already runs this same check, and `docker-publish.yml` gates on
# `ci.yml`, so a broken mirror cannot reach production either way. What CI
# cannot do is keep it out of the history: by the time CI speaks, the commit
# is on `main`. This is the same check one step earlier.
#
# This repo no longer authors ring.json -- it mirrors indienodes-ring,
# refreshed by `npm run ring:sync`. So unlike the check this replaced, there
# is nothing to rebuild here: a failure means either something hand-edited
# the mirror directly (don't -- it will be overwritten on the next sync) or
# the mirror was left mid-way through a sync that itself failed.
#
# Network-free on purpose, same reasoning as ci.yml's own step: this checks
# that what's already committed is well-formed, not whether it's fresh.
# Freshness is `ring:sync`'s job, not a push-time concern.
#
# Note it validates the working tree, not the commits being pushed.
# Uncommitted drift blocks the push too. That is the intended bias — the
# check is cheap and a broken mirror is worth knowing about — but it is why
# the escape hatch below is worth knowing.
#
# To bypass once: git push --no-verify
# To turn off entirely: git config --unset core.hooksPath

if [ ! -f scripts/validate-ring-mirror.mjs ]; then
	exit 0 # Not a full checkout; nothing to validate against.
fi

if ! node scripts/validate-ring-mirror.mjs; then
	echo ''
	echo 'pre-push: the ring mirror is malformed, so this push was stopped.'
	echo '          Run `npm run ring:sync` to refresh it from the canonical'
	echo '          source, commit the result, and try again.'
	echo '          To push anyway: git push --no-verify'
	exit 1
fi
